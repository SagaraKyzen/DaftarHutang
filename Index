<!DOCTYPE html>
<html>
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-gray-400 flex justify-center items-center min-h-screen">
    <div class="bg-gray-400 p-6 rounded-lg w-full max-w-2xl">
        <div class="space-y-4">
            <div class="flex items-center">
                <label class="w-1/4 font-bold">NAMA</label>
                <input type="text" id="nama" class="w-3/4 border border-black p-2">
            </div>
            <div class="flex items-center">
                <label class="w-1/4 font-bold">JENIS</label>
                <select id="jenis" class="w-3/4 border border-black p-2">
                    <option value="UTANG">UTANG</option>
                    <option value="PIUTANG">PIUTANG</option>
                </select>
            </div>
            <div class="flex items-center">
                <label class="w-1/4 font-bold">NOMINAL</label>
                <input type="number" id="nominal" class="w-3/4 border border-black p-2">
            </div>
            <div class="flex items-center">
                <label class="w-1/4 font-bold">STATUS</label>
                <select id="status" class="w-3/4 border border-black p-2">
                    <option value="BELUM LUNAS">BELUM LUNAS</option>
                    <option value="LUNAS">LUNAS</option>
                </select>
            </div>
            <div class="flex justify-center">
                <button onclick="addData()" class="bg-indigo-500 hover:bg-cyan-500 text-white font-bold py-2 px-4 rounded">SIMPAN</button>
            </div>
        </div>
        <div class="mt-6 bg-white p-4 rounded-lg">
            <p class="font-bold">TOTAL UTANG BELUM LUNAS: <span id="totalUtang">0</span></p>
            <p class="font-bold">TOTAL PIUTANG BELUM LUNAS: <span id="totalPiutang">0</span></p>
        </div>
        <div class="mt-6">
            <table class="w-full border border-black">
                <thead>
                    <tr>
                        <th class="border border-black p-2">NAMA</th>
                        <th class="border border-black p-2">JENIS</th>
                        <th class="border border-black p-2">NOMINAL</th>
                        <th class="border border-black p-2">STATUS</th>
                        <th class="border border-black p-2">AKSI</th>
                    </tr>
                </thead>
                <tbody id="dataTable">
                    <!-- Data will be inserted here -->
                </tbody>
            </table>
        </div>
    </div>

    <script>
        let totalUtang = 0;
        let totalPiutang = 0;
        let editIndex = -1;

        document.addEventListener('DOMContentLoaded', (event) => {
            loadData();
        });

        function addData() {
            const nama = document.getElementById('nama').value;
            const jenis = document.getElementById('jenis').value;
            const nominal = parseInt(document.getElementById('nominal').value);
            const status = document.getElementById('status').value;

            if (nama && jenis && nominal && status) {
                if (editIndex === -1) {
                    const table = document.getElementById('dataTable');
                    const row = table.insertRow();
                    row.insertCell(0).innerText = nama;
                    row.insertCell(1).innerText = jenis;
                    row.insertCell(2).innerText = nominal;
                    row.insertCell(3).innerText = status;
                    row.insertCell(4).innerHTML = `<a href="#" class="text-blue-600" onclick="editData(this)">EDIT</a> | <a href="#" class="text-red-600" onclick="confirmDelete(this)">HAPUS</a>`;

                    if (jenis === 'UTANG' && status === 'BELUM LUNAS') {
                        totalUtang += nominal;
                    } else if (jenis === 'PIUTANG' && status === 'BELUM LUNAS') {
                        totalPiutang += nominal;
                    }
                } else {
                    const table = document.getElementById('dataTable');
                    const row = table.rows[editIndex];
                    const oldJenis = row.cells[1].innerText;
                    const oldNominal = parseInt(row.cells[2].innerText);
                    const oldStatus = row.cells[3].innerText;

                    row.cells[0].innerText = nama;
                    row.cells[1].innerText = jenis;
                    row.cells[2].innerText = nominal;
                    row.cells[3].innerText = status;

                    if (oldJenis === 'UTANG' && oldStatus === 'BELUM LUNAS') {
                        totalUtang -= oldNominal;
                    } else if (oldJenis === 'PIUTANG' && oldStatus === 'BELUM LUNAS') {
                        totalPiutang -= oldNominal;
                    }

                    if (jenis === 'UTANG' && status === 'BELUM LUNAS') {
                        totalUtang += nominal;
                    } else if (jenis === 'PIUTANG' && status === 'BELUM LUNAS') {
                        totalPiutang += nominal;
                    }

                    editIndex = -1;
                }

                document.getElementById('totalUtang').innerText = totalUtang;
                document.getElementById('totalPiutang').innerText = totalPiutang;

                saveData();

                // Clear input fields
                document.getElementById('nama').value = '';
                document.getElementById('jenis').value = 'UTANG';
                document.getElementById('nominal').value = '';
                document.getElementById('status').value = 'BELUM LUNAS';
            }
        }

        function editData(element) {
            const row = element.parentElement.parentElement;
            editIndex = row.rowIndex - 1;

            document.getElementById('nama').value = row.cells[0].innerText;
            document.getElementById('jenis').value = row.cells[1].innerText;
            document.getElementById('nominal').value = row.cells[2].innerText;
            document.getElementById('status').value = row.cells[3].innerText;
        }

        function confirmDelete(element) {
            if (confirm("Yakin Hapus data?")) {
                deleteData(element);
            }
        }

        function deleteData(element) {
            const row = element.parentElement.parentElement;
            const jenis = row.cells[1].innerText;
            const nominal = parseInt(row.cells[2].innerText);
            const status = row.cells[3].innerText;

            if (jenis === 'UTANG' && status === 'BELUM LUNAS') {
                totalUtang -= nominal;
            } else if (jenis === 'PIUTANG' && status === 'BELUM LUNAS') {
                totalPiutang -= nominal;
            }

            document.getElementById('totalUtang').innerText = totalUtang;
            document.getElementById('totalPiutang').innerText = totalPiutang;

            row.remove();
            saveData();
        }

        function saveData() {
            const table = document.getElementById('dataTable');
            const rows = table.rows;
            const data = [];

            for (let i = 0; i < rows.length; i++) {
                const row = rows[i];
                const rowData = {
                    nama: row.cells[0].innerText,
                    jenis: row.cells[1].innerText,
                    nominal: parseInt(row.cells[2].innerText),
                    status: row.cells[3].innerText
                };
                data.push(rowData);
            }

            localStorage.setItem('data', JSON.stringify(data));
            localStorage.setItem('totalUtang', totalUtang);
            localStorage.setItem('totalPiutang', totalPiutang);
        }

        function loadData() {
            const data = JSON.parse(localStorage.getItem('data')) || [];
            totalUtang = parseInt(localStorage.getItem('totalUtang')) || 0;
            totalPiutang = parseInt(localStorage.getItem('totalPiutang')) || 0;

            const table = document.getElementById('dataTable');
            for (const rowData of data) {
                const row = table.insertRow();
                row.insertCell(0).innerText = rowData.nama;
                row.insertCell(1).innerText = rowData.jenis;
                row.insertCell(2).innerText = rowData.nominal;
                row.insertCell(3).innerText = rowData.status;
                row.insertCell(4).innerHTML = `<a href="#" class="text-blue-600" onclick="editData(this)">EDIT</a> | <a href="#" class="text-red-600" onclick="confirmDelete(this)">HAPUS</a>`;
            }

            document.getElementById('totalUtang').innerText = totalUtang;
            document.getElementById('totalPiutang').innerText = totalPiutang;
        }
    </script>
</body>
</html>
